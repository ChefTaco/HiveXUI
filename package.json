{
  "name": "@hivemagnus/hivexui",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "bash scripts/ci-apt-setup.test.sh && vitest run",
    "e2e": "playwright test",
    "e2e:stack": "node e2e/stack/stack.mjs",
    "e2e:a11y": "playwright test --config playwright.a11y.config.ts",
    "scan:secrets": "bash scripts/scan-secrets.sh",
    "check:private": "bash scripts/check-private-data.sh",
    "postbuild": "node scripts/collect-browser-licenses.mjs",
    "check:contracts": "node scripts/check-owned-identity-skills.mjs && node scripts/generate-memory-client.mjs --check && node scripts/check-chat-contracts.mjs && node scripts/check-emberpath-contracts.mjs && node scripts/check-security-contracts.mjs && node scripts/check-magnus-contracts.mjs && node scripts/check-registry-contracts.mjs && node scripts/check-ardentstudio-contracts.mjs && node scripts/check-embermend-contracts.mjs",
    "contracts:magnus:import": "node scripts/import-magnus-contracts.mjs",
    "magnus:provenance": "node scripts/record-magnus-provenance.mjs",
    "contracts:ardentstudio:import": "node scripts/import-ardentstudio-contracts.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.3",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@hivemagnus/hive-common": "^0.4.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "@xyflow/react": "12.12.0",
    "clsx": "2.1.0",
    "diff": "9.0.0",
    "jose": "6.2.3",
    "lucide-react": "1.64.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "10.1.0",
    "recharts": "3.10.1",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "jsdom": "31.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "^7.2.2",
    "vitest": "^5.0.5"
  }
}
