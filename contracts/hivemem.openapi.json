      }
    },
    "/v1/workspaces": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "include_deleted",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "maximum": 200,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Workspace"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Permitted workspaces"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "List permitted workspaces, optionally including archived records"
      },
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WorkspaceCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Workspace"
                }
              }
            },
            "description": "Success"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Permission or workspace membership required"
          },
          "409": {
            "description": "Archived workspace IDs are reserved"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Create workspace; an archived ID cannot be reused"
      }
    },
    "/v1/workspaces/{workspaceId}": {
      "delete": {
        "responses": {
          "204": {
            "description": "Archived"
